{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:Put*"
      ],
      "Resource": "arn:aws:s3:::bucketteraclase2025/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": ["arn:aws:s3:::bucketteraclase2025/",
                    "arn:aws:s3:::bucketteraclase2025/*"]
    }
  ]
}
